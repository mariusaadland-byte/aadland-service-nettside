# Vipps MobilePay. Keep Service and Rental as separate sales units.
# Set VIPPS_ENV=test while using test credentials; use production for live.
# Keep PAYMENTS_ENABLED=false until credentials, webhooks and test transactions are verified.
VIPPS_ENV=production
VIPPS_PAYMENTS_ENABLED=false
VIPPS_WEBHOOK_URL=https://www.aadland-service.no/api/vipps/webhook
