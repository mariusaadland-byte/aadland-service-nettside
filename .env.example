NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
# Optional separate HMAC key for rate-limit identifiers. Falls back to SESSION_SECRET.
RATE_LIMIT_SECRET=
QUOTE_LINK_SECRET=
CUSTOMER_VERIFY_SECRET=
CUSTOMER_PASSWORD_RESET_SECRET=
RESEND_API_KEY=
# Automated Aadland Service mail: confirmations, receipts, status/refund notices and account/security mail.
# Quotes/offers continue to use post@aadland-service.no directly.
ORDER_EMAIL_TO=post@aadland-service.no
SERVICE_EMAIL_FROM=Aadland Service <noreplay@aadland-service.no>
SERVICE_REPLY_TO=post@aadland-service.no
RENTAL_EMAIL_FROM=Aadland Utleie <noreplay@aadlandutleie.no>
RENTAL_REPLY_TO=post@aadland-service.no
RENTAL_SITE_URL=https://www.aadlandutleie.no
RESEND_PREVIEW_API_KEY=
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=https://www.aadland-service.no
ADMIN_PASSWORD_RESET_SECRET=

# Vipps MobilePay. Keep Service and Rental as separate sales units.
# Set VIPPS_ENV=test while using test credentials; use production for live.
# Safe setup order:
# 1) Keep PAYMENTS_ENABLED=false.
# 2) Add API keys/MSN for both sales units.
# 3) Open /admin/vipps, test API access and register webhooks while payments are still off.
# 4) Confirm "Test oppsett" is green for both sales units.
# 5) Complete Vipps test payments before enabling production customer payments.
VIPPS_ENV=production
VIPPS_PAYMENTS_ENABLED=false
VIPPS_WEBHOOK_URL=https://www.aadland-service.no/api/vipps/webhook
VIPPS_SERVICE_CLIENT_ID=
VIPPS_SERVICE_CLIENT_SECRET=
VIPPS_SERVICE_SUBSCRIPTION_KEY=
VIPPS_SERVICE_MSN=
VIPPS_RENTAL_CLIENT_ID=
VIPPS_RENTAL_CLIENT_SECRET=
VIPPS_RENTAL_SUBSCRIPTION_KEY=
VIPPS_RENTAL_MSN=
