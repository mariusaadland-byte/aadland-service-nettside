# Vipps MobilePay. Each legal sales unit has separate API credentials AND a separate enable flag.
# Safe setup order:
# 1) Leave both unit flags false. The legacy VIPPS_PAYMENTS_ENABLED is intentionally ignored.
# 2) Set production credentials for Aadland Service; rental credentials can be added later.
# 3) Redeploy Vercel so server-side credentials are available.
# 4) /admin/vipps: Test oppsett, register and verify the webhook for the desired unit.
# 5) Complete controlled end-to-end tests, get explicit approval before enabling that unit.
# 6) Set only that unit's flag true; redeploy again. Never copy credentials to client code.
VIPPS_ENV=production
VIPPS_SERVICE_PAYMENTS_ENABLED=false
VIPPS_RENTAL_PAYMENTS_ENABLED=false
# Second switches explicitly release live Vipps buttons to regular customers.
# Both are false for the admin-only pilot. No public checkout can start.
VIPPS_SERVICE_PUBLIC_PAYMENTS_ENABLED=false
VIPPS_RENTAL_PUBLIC_PAYMENTS_ENABLED=false
# Owner-controlled pilot is restricted to EXACTLY 1.00 NOK / 100 øre to this inbox.
# Set in Vercel Production (don't add a real value to committed .env files).
VIPPS_SERVICE_PILOT_EMAIL=
# Only enable after Vipps explicitly approves PUSH_MESSAGE for Aadland Service MSN.
# Requires customer physically present and explicit consent to the phone number.
# Default disabled. This does NOT activate public customer checkout.
VIPPS_SERVICE_PUSH_ENABLED=false
VIPPS_WEBHOOK_URL=https://www.aadland-service.no/api/vipps/webhook
VIPPS_SERVICE_CLIENT_ID=
VIPPS_SERVICE_CLIENT_SECRET=
VIPPS_SERVICE_SUBSCRIPTION_KEY=
VIPPS_SERVICE_MSN=
VIPPS_RENTAL_CLIENT_ID=
VIPPS_RENTAL_CLIENT_SECRET=
VIPPS_RENTAL_SUBSCRIPTION_KEY=
VIPPS_RENTAL_MSN=
